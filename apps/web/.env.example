# ===========================================================================
# FAME — Frontend build-time environment
# ---------------------------------------------------------------------------
# Copy to `.env` (in this directory) and adjust. These are build-time values
# (NOT secrets) exposed to the browser via import.meta.env.*, so never put
# passwords or keys here.
# ===========================================================================

# Absolute URL of the Spring Boot API (leave empty to use same-origin proxy).
# When empty, the app uses the same-origin /api reverse proxy (recommended).
VITE_API_BASE_URL=

# URL of the deployed Cloudflare SchoolApp authentication Worker.
VITE_WORKER_URL=https://fame-auth.example.workers.dev

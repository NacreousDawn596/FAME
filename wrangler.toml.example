# Cloudflare Worker configuration for the SchoolApp authentication Worker.
# Copy to `wrangler.toml` and fill in values. `schoolapp.js` sits next to this file.

name = "fame-schoolapp"
main = "schoolapp.js"
compatibility_date = "2024-11-01"

[vars]
# Issuer / audience must match the FAME backend (SCHOOLAPP_ISSUER / SCHOOLAPP_AUDIENCE).
SCHOOLAPP_ISSUER = "fame-schoolapp"
SCHOOLAPP_AUDIENCE = "fame-api"
# Upstream SchoolApp authentication API base URL.
SCHOOLAPP_API_URL = "https://your-schoolapp-api.example.com"
# The FAME frontend origin (CORS).
ALLOWED_ORIGIN = "https://fame.example.com"

# The Ed25519 private signing key (base64url, 32-byte seed) — generated by
# `python scripts/generate_keys.py`. Set it as a SECRET, never in [vars]:
#
#   wrangler secret put SCHOOLAPP_PRIVATE_KEY
#
# The matching PUBLIC key goes into the backend .env as SCHOOLAPP_PUBLIC_KEY.

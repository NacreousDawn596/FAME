[Unit]
Description=FAME WhatsApp bridge (whatsapp-web.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/fame/bridge
ExecStart=%h/.nix-profile/bin/node bridge.js
Restart=on-failure
RestartSec=5
Environment=PORT=3000 HOST=0.0.0.0

[Install]
WantedBy=default.target

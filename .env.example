# ---------------------------------------------------------------------------
# FAME — Docker Compose environment (placeholders only, no real secrets)
# Copy to `.env` and fill in. Used ONLY for the infrastructure services
# (PostgreSQL / Redis) in docker-compose.yml. All backend application config
# lives in `config.yml` (see config.yml.example). Frontend build config lives
# in `apps/web/.env` (see apps/web/.env.example).
# ---------------------------------------------------------------------------

# --- PostgreSQL (internal network only) ---
POSTGRES_DB=fame
POSTGRES_USER=fame
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_PORT=5432

# --- Redis (internal network only) ---
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_PORT=6379

# --- Reverse proxy ---
WEB_PORT=8080

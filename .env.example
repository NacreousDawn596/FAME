# =============================================================================
# FAME — Environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---------------------------------------------------------------------------
# Database / Redis
# ---------------------------------------------------------------------------
POSTGRES_DB=fame
POSTGRES_USER=fame
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgresql+asyncpg://fame:change-me-postgres@postgres:5432/fame
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# SchoolApp (Cloudflare Worker) integration
# ---------------------------------------------------------------------------
# URL of the deployed Cloudflare Worker that authenticates candidates.
SCHOOLAPP_WORKER_URL=https://schoolapp-worker.example.workers.dev

# Base64-encoded Ed25519 PUBLIC key (the Worker signs with the matching private key).
# Generate with: `python scripts/generate_keys.py`
SCHOOLAPP_PUBLIC_KEY=

# Expected JWT claims. Must match what schoolapp.js emits.
SCHOOLAPP_ISSUER=fame-schoolapp
SCHOOLAPP_AUDIENCE=fame-api

# ---------------------------------------------------------------------------
# Organizer account bootstrap
# ---------------------------------------------------------------------------
# Comma-separated list of "username:email" entries. On first startup the backend
# creates these organizers (password generated & printed once to logs), or use
# the CLI `scripts/create_organizer.py` to set a known password.
ORGANIZER_INITIAL_EMAILS=

# ---------------------------------------------------------------------------
# Session / security
# ---------------------------------------------------------------------------
# Random secret used to sign candidate session JWTs & CSRF tokens.
SESSION_SECRET=change-me-session-secret-please-use-32-random-bytes

# Comma-separated list of allowed CORS origins (the frontend URL).
ALLOWED_ORIGINS=http://localhost:5483,http://localhost:5173

# Environment: development | production
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Regulators and rooms
# ---------------------------------------------------------------------------
# Comma-separated names. regulator[i] is paired with rooms[i] (by index).
REGULATORS=Regulator A,Regulator B
ROOMS=Room 1,Room 2

# ---------------------------------------------------------------------------
# VAPID (Web Push)
# ---------------------------------------------------------------------------
# Generate with: `python scripts/generate_keys.py`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@fame.local

# ---------------------------------------------------------------------------
# Additional notification channels
# ---------------------------------------------------------------------------
# Email notifications (FormSubmit) are delivered to this address.
NOTIFICATION_EMAIL=fame@gadzarts.xyz
# WhatsApp notifications go through a local whatsapp-web.js bridge.
# In Docker, use host.docker.internal to reach the host bridge.
WHATSAPP_BRIDGE_URL=http://host.docker.internal:3000
EMAIL_NOTIFICATIONS_ENABLED=true
WHATSAPP_NOTIFICATIONS_ENABLED=true

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
# Public URL of the app (everything is served through the single nginx port).
FRONTEND_URL=http://localhost:5483
API_URL=http://localhost:5483

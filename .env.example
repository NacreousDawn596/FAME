# ---------------------------------------------------------------------------
# FAME — environment variable template (placeholders only, no real secrets)
# Copy to `.env` (or `.env.production`) and fill in real values. Never commit.
# ---------------------------------------------------------------------------

# --- PostgreSQL (internal network only) ---
POSTGRES_DB=fame
POSTGRES_USER=fame
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_PORT=5432

# --- Redis (internal network only) ---
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_PORT=6379

# --- Spring Boot API ---
# Session secret (>= 32 random bytes). Generate: openssl rand -base64 48
FAME_SESSION_SECRET=change-me
# Worker public key (Ed25519, base64url). Must match WORKER_SIGNING_KEY private key.
FAME_WORKER_PUBLIC_KEY=change-me-ed25519-public-key
# Expected Worker issuer + audience
FAME_WORKER_ISSUER=https://fame-auth.example.workers.dev
FAME_WORKER_AUDIENCE=fame-api
# Academic email domain(s) accepted (comma separated)
FAME_ACADEMIC_DOMAINS=ensam-umi.ac.ma
# VAPID keys for Web Push (generate: npx web-push generate-vapid-keys)
FAME_VAPID_PUBLIC_KEY=change-me
FAME_VAPID_PRIVATE_KEY=change-me
FAME_VAPID_SUBJECT=mailto:ops@example.com
# Allowed CORS origins (comma separated)
FAME_CORS_ORIGINS=https://fame.example.com,http://localhost:5173
# Initial bootstrap admin (used only on first migration seed)
FAME_ADMIN_USERNAME=admin
FAME_ADMIN_PASSWORD=change-me-strong-admin-password
FAME_ADMIN_DISPLAY_NAME=Administrateur

# --- Frontend (Vite build-time, non-secret) ---
VITE_API_BASE_URL=https://fame.example.com/api
VITE_WORKER_URL=https://fame-auth.example.workers.dev

# --- Reverse proxy ---
FAME_PUBLIC_DOMAIN=fame.example.com

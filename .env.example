# ---------------------------------------------------------------------------
# FAME — Docker Compose environment (placeholders only, no real secrets)
# Copy to `.env` and fill in. Used ONLY for the infrastructure services
# (PostgreSQL / Redis) in docker-compose.yml. All backend application config
# lives in `config.yml` (see config.yml.example). Frontend build config lives
# in `apps/web/.env` (see apps/web/.env.example).
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_DB=fame
POSTGRES_USER=fame
POSTGRES_PASSWORD=change-me-strong-db-password
# Host port to expose Postgres on (5432 is the standard; change if taken).
POSTGRES_PORT=5432

# --- Redis (internal only — cache/sessions, no public data) ---
REDIS_PASSWORD=change-me-strong-redis-password

# --- Single public entry point (reverse proxy: frontend + /api backend) ---
WEB_PORT=8080
